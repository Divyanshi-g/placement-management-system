{% extends "base.html" %}
{% block title %}Student Profile Details{% endblock %}
{% block content %}

<div class="container mt-5 mb-5">

    <h2 class="fw-bold text-white text-center">Student Profile Details</h2>
    <hr class="text-light">

    <div class="row mt-4">

        <!-- Profile Picture Section -->
        <div class="col-md-4 text-center">
            {% if student.profile_pic %}
                <img src="{{ url_for('static', filename='uploads/profile/' + student.profile_pic) }}"
                     class="img-fluid rounded shadow profile-img"
                     style="cursor:pointer; max-height: 260px;"
                     onclick="openImageModal(this.src)">
            {% else %}
                <img src="{{ url_for('static', filename='default_profile.png') }}"
                     class="img-fluid rounded shadow"
                     style="max-height: 260px;">
            {% endif %}

            <p class="mt-2 text-light fw-semibold">
                {{ student.full_name or student.username }}
            </p>
        </div>


        <!-- Profile Details -->
        <div class="col-md-8">

            <div class="table-responsive bg-dark p-3 rounded shadow">
                <table class="table table-bordered table-dark mb-0">

                    <tr><th>User ID</th><td>{{ student.user_id }}</td></tr>
                    <tr><th>Full Name</th><td>{{ student.full_name or "Not Added" }}</td></tr>
                    <tr><th>Phone</th><td>{{ student.phone or "Not Added" }}</td></tr>
                    <tr><th>Gender</th><td>{{ student.gender or "Not Added" }}</td></tr>

                    <tr><th>Course</th><td>{{ student.course or "Not Added" }}</td></tr>
                    <tr><th>Branch</th><td>{{ student.branch or "Not Added" }}</td></tr>
                    <tr><th>Passing Year</th><td>{{ student.passing_year or "Not Added" }}</td></tr>
                    <tr><th>CGPA</th><td>{{ student.cgpa or "Not Added" }}</td></tr>

                    <tr><th>Skills</th><td>{{ student.skills or "Not Added" }}</td></tr>
                    <tr><th>Certifications</th><td>{{ student.certifications or "Not Added" }}</td></tr>

                    <tr><th>LinkedIn</th>
                        <td>
                            {% if student.linkedin %}
                                <a href="{{ student.linkedin }}" target="_blank" class="btn btn-primary btn-sm">
                                    Visit Profile
                                </a>
                            {% else %}
                                Not Added
                            {% endif %}
                        </td>
                    </tr>

                    <tr><th>GitHub</th>
                        <td>
                            {% if student.github %}
                                <a href="{{ student.github }}" target="_blank" class="btn btn-dark btn-sm">
                                    Open GitHub
                                </a>
                            {% else %}
                                Not Added
                            {% endif %}
                        </td>
                    </tr>

                    <tr><th>Bio</th><td>{{ student.bio or "Not Added" }}</td></tr>

                </table>
            </div>

            <!-- Buttons -->
            <div class="mt-4 d-flex gap-2">

                {% if student.resume %}
                <a class="btn btn-success"
                   href="{{ url_for('static', filename='uploads/resumes/' + student.resume) }}"
                   download>
                    📥 Download Resume
                </a>
                {% endif %}

                <a href="{{ url_for('enhancements.admin_students') }}"
                   class="btn btn-secondary">
                    ⬅ Back
                </a>
            </div>

        </div>
    </div>
</div>


<!-- 🔍 IMAGE POPUP MODAL -->
<div id="imageModal"
     style="display:none; position:fixed; top:0; left:0;
            width:100%; height:100%; background:rgba(0,0,0,.8);
            justify-content:center; align-items:center; z-index:9999">

    <img id="modalImg" style="max-width:70%; max-height:80%; border-radius:12px;">

</div>

<script>
    function openImageModal(src) {
        document.getElementById("modalImg").src = src;
        document.getElementById("imageModal").style.display = "flex";
    }

    document.getElementById("imageModal").onclick = function () {
        this.style.display = "none";
    };
</script>

{% endblock %}
